{
    "name": "ecourty/platform-parameter-bundle",
    "description": "Symfony bundle for managing global platform parameters with type-safe access and caching",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Edouard Courty",
            "email": "edouard.courty2@gmail.com",
            "homepage": "https://github.com/EdouardCourty"
        }
    ],
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.18|^3.1",
        "doctrine/orm": "^3.0|^4.0",
        "psr/cache": "^2.0|^3.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/uid": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "easycorp/easyadmin-bundle": "^4.27",
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/asset": "^6.4|^7.0|^8.0",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/css-selector": "^6.4|^7.0|^8.0",
        "symfony/dotenv": "^6.4|^7.0|^8.0",
        "symfony/form": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/phpunit-bridge": "^6.4|^7.0|^8.0",
        "symfony/runtime": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "symfony/validator": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "twig/html-extra": "^3.22"
    },
    "autoload": {
        "psr-4": {
            "Ecourty\\PlatformParameterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ecourty\\PlatformParameterBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "qa": [
            "@phpstan",
            "@cs-check",
            "@test"
        ]
    },
    "suggest": {
        "easycorp/easyadmin-bundle": "To use the provided CRUD controller for managing parameters"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
